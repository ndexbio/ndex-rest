<?xml version="1.0" encoding="UTF-8"?>
<!-- Console-only logging used by DbMigrationTool (see DbMigrationTool.main). Deliberately has NO file
     appender so one-off CLI runs never write to ../logs. Selected via -Dlogback.configurationFile. -->
<configuration>
	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>[%date]&#9;[%level]&#9;%logger{0}&#9;%msg%n</pattern>
		</encoder>
	</appender>
	<root level="info">
		<appender-ref ref="STDOUT"/>
	</root>
</configuration>
